{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "publish": "wrangler publish",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 execute tabletennis-availability --local --file=./schema.sql",
    "db:migrate:staging": "wrangler d1 execute tabletennis-availability-staging --file=./schema.sql",
    "db:migrate:production": "wrangler d1 execute tabletennis-availability-prod --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute tabletennis-availability --local --file=./seed.sql",
    "db:seed:staging": "wrangler d1 execute tabletennis-availability-staging --file=./seed.sql",
    "db:create:staging": "wrangler d1 create tabletennis-availability-staging",
    "db:create:production": "wrangler d1 create tabletennis-availability-prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "wrangler d1 execute tabletennis-availability --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.11.3",
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "typescript": "^5.1.0",
    "vitest": "^4.0.16",
    "wrangler": "^3.15.0"
  }
}
